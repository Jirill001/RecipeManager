<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecipeManager.ViewModels"
        x:Class="RecipeManager.Views.ProductEditWindow"
        x:DataType="vm:ProductEditViewModel"
        Title="Редактировать продукт"
        Width="400" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="LightYellow">

    <StackPanel Margin="15" Spacing="10">
        <TextBlock Text="Название:"/>
        <TextBox Text="{Binding Name}"/>

        <TextBlock Text="Цена:"/>
        <TextBox Text="{Binding Price}"/>

        <TextBlock Text="Единица измерения:"/>
        <TextBox Text="{Binding Unit}"/>

        <TextBlock Text="Количество в единице (напр. 1 для кг, 0.5 для 500г):"/>
        <TextBox Text="{Binding UnitQuantity}"/>

        <Button Content="Сохранить"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"/>
    </StackPanel>
</Window>