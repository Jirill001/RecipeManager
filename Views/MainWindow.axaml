<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecipeManager.ViewModels"
        x:Class="RecipeManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Менеджер рецептов"
        Width="900" Height="600"
        Background="LightYellow">

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10" Spacing="5">
            <Button Content="Продукты" Command="{Binding ShowProductsCommand}"/>
            <Button Content="Теги" Command="{Binding ShowTagsCommand}"/>
            <Button Content="Рецепты" Command="{Binding ShowRecipesCommand}"/>
            <Button Content="Покупки" Command="{Binding ShowShoppingListCommand}"/>
        </StackPanel>

        <ContentControl Content="{Binding CurrentView}" Margin="10"/>
    </StackPanel>
</Window>